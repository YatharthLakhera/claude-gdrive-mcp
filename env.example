# --- Required: Google OAuth client (Web application type in GCP Console) ---
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# OAuth redirect URI (must match what's registered in GCP Console).
# Local dev: http://localhost:8000/oauth2callback
# Railway:   https://<your-service>.up.railway.app/oauth2callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/oauth2callback

# --- Transport ---
# Local: stdio (default) or streamable-http.
# Railway: streamable-http (required).
WORKSPACE_MCP_TRANSPORT=streamable-http

# HTTP server bind (only used when transport=streamable-http).
WORKSPACE_MCP_PORT=8000
WORKSPACE_MCP_HOST=0.0.0.0
# Externally-reachable URL (Railway provides $RAILWAY_PUBLIC_DOMAIN).
# Used for the OAuth callback redirect — must match Google client config.
WORKSPACE_EXTERNAL_URL=https://your-service.up.railway.app

# --- Auth mode ---
# OAuth 2.1 multi-user (recommended for Claude.ai/Railway). When true,
# clients send a bearer token; the server validates against Google.
MCP_ENABLE_OAUTH21=true

# Stateless mode keeps no per-session state on disk; required when running
# behind a stateless proxy (Railway in some configurations).
WORKSPACE_MCP_STATELESS_MODE=true

# Where to persist user credentials when NOT stateless. Local dev only.
# WORKSPACE_MCP_CREDENTIALS_DIR=./store_creds

# --- Single-user fallback (skip if using OAuth 2.1) ---
# Set this if you want to run with one fixed Google account (legacy mode).
# USER_GOOGLE_EMAIL=you@example.com
# MCP_SINGLE_USER_MODE=1

# --- Limits ---
# Max base64 blob size (in MB) that download_file_content will return inline.
# Files larger than this fail with a descriptive error pointing to
# read_file_content (text extraction) or get_drive_shareable_link.
# Default: 25.
# DOWNLOAD_FILE_CONTENT_MAX_MB=25

# --- Logging ---
# LOG_LEVEL=INFO
